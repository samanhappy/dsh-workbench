# Editor defaults for dsh-workbench.
# Keep this file minimal: it encodes only what the repository actually relies
# on (2-space indentation, LF, UTF-8, final newline).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown keeps hard line breaks meaningful.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,json}]
indent_size = 2
