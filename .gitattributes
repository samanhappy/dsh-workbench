# Normalize line endings for every text file, on every platform.
* text=auto eol=lf

# Binary assets: never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Committed build artifacts (generated by build.mjs, never hand-edited):
# keep them out of language statistics and collapse them in diffs.
index.js linguist-generated=true
lib/client.js linguist-generated=true

# The lockfile is generated by npm; link to it instead of showing a huge diff.
package-lock.json -diff
